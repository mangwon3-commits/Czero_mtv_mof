_pd_proc_ls_special_details      
; The use of a rigid body description for the ligand does not allow 
  the derivation of statistically  meaningful s.u.'s for their atoms.
  S.u.'s are available only for the position of the center of mass (X, Y, Z)
  and for the rotational angles (RX, RY, RZ) of the rigid body.
  
    
rigid body description:
  
prm ref1 -11.08545`_0.18087 min -14
prm ref2 =ref1;  

prm benz  1.40984`_0.00680_LIMIT_MAX_1.41 min 1.35 max 1.41
prm pyr  1.35937`_0.00253_LIMIT_MAX_1.36 min 1.34 max 1.36

rigid

z_matrix C1
z_matrix C2 C1 =benz;
z_matrix C3 C2 =benz; C1 120
z_matrix C4 C3 =benz; C2 120 C1 0
z_matrix C5 C4 =benz; C3 120 C1 0
z_matrix C6 C5 =benz; C4 120 C1 0
z_matrix F1 C5 @  1.32000 min 1.32 max 1.35 C6 -120 C1 0
z_matrix F2 C2 @  1.35000 min 1.32 max 1.35 C3 -120 C1 0

z_matrix C7 C1 @  1.53000 min 1.45 max 1.53  C6 -120 C2 =ref1;
z_matrix C8 C7 =pyr; C1 126 C2 =ref1;
z_matrix C9 C7 =pyr; C1 -126 C2 =ref1;
z_matrix N1 C8 =pyr; C7 -108 C2 =ref1;
z_matrix N2 C9 =pyr; C7 -108 C2 =-ref1;

z_matrix C10 C4 @  1.53000 min 1.45 max 1.53 C5 -120 C3 =ref2;
z_matrix C11 C10 =pyr; C4 126 C3 =ref2;
z_matrix C12 C10 =pyr; C4 -126 C3 =ref2;
z_matrix N3 C11 =pyr; C10 -108 C3 =ref2;
z_matrix N4 C12 =pyr; C10 -108 C3 =-ref2;

Rotate_about_points(@ -6.44358`_0.88811,C1,C7,"C8 C9 N1 N2")
Rotate_about_points(@ -10.00581`_1.21726,C4,C10,"C11 C12 N3 N4")


Rotate_about_axies(@  253.60367`_0.17857, @ -206.12707`_0.11150, 
	@  109.67277`_0.11037)
Translate(@ -0.23177`_0.00117, @ -0.68865`_0.00041, @ -0.80775`_0.00095)


